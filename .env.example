APP_NAME="Jastip Seoul Tokyo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://jastip.test
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database: SQLite (tidak perlu install MySQL). File: database/database.sqlite
DB_CONNECTION=sqlite
# Kalau mau pakai MySQL, ganti jadi:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=jastip
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# ---- Email ----
# MAIL_MAILER=log  -> email tidak benar-benar dikirim, kode masuk tampil di layar (mode uji).
# Untuk kirim sungguhan (contoh Gmail, pakai App Password):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=emailkamu@gmail.com
# MAIL_PASSWORD="app password 16 huruf"
# MAIL_SCHEME=null
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="admin@jastip.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Info toko (tampil di website) ----
JASTIP_NAMA="Jastip Seoul Tokyo"
JASTIP_WHATSAPP=628xxxxxxxxxx
JASTIP_SHOPEE_TOKO=nama_toko
JASTIP_SHOPEE_URL=https://shopee.co.id/
JASTIP_REKENING="BCA 1234567890 a.n. Nama Pemilik"
JASTIP_ESTIMASI_JP="7–14"
JASTIP_ESTIMASI_KR="7–14"
JASTIP_KURS_DIKUNCI_JAM=24

# ---- Syarat & ketentuan (halaman /ketentuan) ----
JASTIP_REFUND_HARI=3
JASTIP_KLAIM_JAM=48
JASTIP_BEA_MASUK="sudah termasuk tarif ongkir per kg"
JASTIP_KETENTUAN_TANGGAL="28 Oktober 2026"

# ---- Akun admin pertama (dibuat saat seeding) ----
ADMIN_EMAIL=admin@jastip.test
ADMIN_PASSWORD=admin12345

VITE_APP_NAME="${APP_NAME}"
